{
  "name": "@figwright/plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Figma plugin for Figwright — UI + sandbox code.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:ui",
    "build:main": "vite build --config vite.config.main.ts",
    "build:ui": "vite build --config vite.config.ts",
    "dev": "vite build --config vite.config.ts --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@vueuse/core": "^14.4.0",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.136.0",
    "@figwright/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^3.3.11"
  }
}
